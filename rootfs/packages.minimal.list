# =============================================================================
# rootfs/packages.minimal.list — Ubuntu GSI minimal footprint preset
# =============================================================================

# Core runtime
systemd
systemd-sysv
dbus
udev
bash
sudo
locales
ca-certificates

# Connectivity baseline
network-manager
iproute2
wpasupplicant
openssh-server

# Audio baseline
pulseaudio
pulseaudio-utils
alsa-utils
libasound2

# Display baseline
libdrm2
libgbm1
libegl1-mesa
libgles2-mesa
libwayland-client0
libwayland-server0

# Mir / libhybris (Android GPU hand-off)
libhybris
libhybris-common1
libhybris-utils
libhardware2
libandroid-properties1
mir-graphics-drivers-android
mir-graphics-drivers-android2
mir-platform-graphics-android15
mir-platform-graphics-android2-15
mir-platform-input-evdev7
qtmir

# Core Lomiri stack only (names that exist on UBports focal)
lomiri
lomiri-common
lomiri-keyboard
lomiri-indicator-network
lomiri-system-settings
lomiri-system-compositor

# Basic tools
curl
jq
nano
less
e2fsprogs


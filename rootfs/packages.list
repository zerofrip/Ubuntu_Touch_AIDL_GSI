# ---------------------------------------------------------------------------
# UBports Apps — Core Applications (apt subset; see also packages.core-apps.list)
# Full CORE_APPS.md mapping:
#   apt  → rootfs/packages.core-apps.list (merged at build time)
#   click → rootfs/clicks.core-apps.list (OpenStore; fetch_openstore_clicks.sh)
#   user extras → rootfs/packages.userdata.list (userdata partition)
# ---------------------------------------------------------------------------
morph-browser
# morph-browser Browser.qml imports QtQuick.Controls (not pulled as Depends)
qml-module-qtquick-controls
qml-module-qtquick-controls2
qml-module-qtquick-templates2
qml-module-qtquick-privatewidgets
# Legacy click apps (Terminal) import Ubuntu.Components → Lomiri compat layer
qml-module-ubuntu-components
qml-module-lomiri-components-extras
dialer-app
messaging-app
address-book-app
mediaplayer-app
# Morph Browser pulls Controls QML but not always the shared libs
libqt5quickcontrols2-5
libqt5quicktemplates2-5

# Setup wizard & fonts

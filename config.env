# =============================================================================
# config.env — Ubuntu GSI build configuration (AIDL variant)
# =============================================================================
# Vendor-specific PHH/Treble settings are loaded from vendor/android-XX.Y.env
# based on git branch or VENDOR_ANDROID_VERSION (see load_vendor_config.sh).
# Prefer android-12.0 .. android-16.0 branches for single-version builds.
# main supports multi-version CI via workflow_dispatch (set VENDOR_ANDROID_VERSION).
# =============================================================================

# Optional override before vendor load (normally auto-detected from branch):
# VENDOR_ANDROID_VERSION=android-16.0

# Ubuntu chroot rootfs settings
ARCH=arm64
UBUNTU_SUITE=focal
UBUNTU_MIRROR=http://ports.ubuntu.com/ubuntu-ports

# EROFS compression (adjust if your kernel only supports plain lz4)
EROFS_COMP=lz4hc,9

# system.img size in MB (0 = auto content + headroom)
SYSTEM_IMG_SIZE_MB=0
# Include rootfs seed under /system/usr/share/ubuntu-gsi (0=smaller system.img)
ROOTFS_SEED_IN_SYSTEM=0
# Rootfs prune level: empty/standard/aggressive (minimal profile defaults to aggressive)
# GSI_ROOTFS_PRUNE_LEVEL=aggressive

# device_phh_treble cache (synced per vendor branch)
# DEVICE_PHH_REPO=https://github.com/TrebleDroid/device_phh_treble.git
# DEVICE_PHH_DIR=builder/cache/device_phh_treble

# Custom PHH build from local treble_experimentations (optional):
# PHH_GSI_SOURCE=custom
# TREBLE_EXP_PATH=/home/zero/github/treble_experimentations
# PHH_CUSTOM_TARGET=android-15.0
# PHH_CUSTOM_VARIANT=td-arm64-ab-vanilla

# Load vendor/android-XX.Y.env (required for build)
# shellcheck source=scripts/load_vendor_config.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]:-.}")" && pwd)/scripts/load_vendor_config.sh"
